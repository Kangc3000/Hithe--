<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Networking to the Hermes host over Tailscale. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Microphone capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera for still-image capture (face-id pipeline input). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Bluetooth: needed by the Meta Wearables Device Access Toolkit
         once that adapter is plugged in. Declared now so first-run
         permission flow can ask for everything in one pass. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Foreground service: required to keep audio capture alive while
         the screen is off. Android 14+ requires the typed permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Notification visible to the user that the relay is running. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Don't run on devices without a mic or BLE. -->
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.AppCompat.DayNight"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The relay foreground service. `mediaPlayback` and `microphone`
             cover the audio paths; `camera` is declared so still-image
             capture works while the screen is off. -->
        <service
            android:name=".RelayService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

    </application>

</manifest>
