<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Vision Companion (解語) relay daemon — macOS launchd unit.

  This is a TEMPLATE. install-on-mac.sh substitutes __PLACEHOLDERS__ before
  installing the rendered file to ~/Library/LaunchAgents/com.hithe.relay-daemon.plist.
  PlistBuddy edits the token after install; see deploy/hermes-deploy-mac/DEPLOY.md.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hithe.relay-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__EXEC_PATH__</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- Apple Silicon: /opt/homebrew/bin, Intel: /usr/local/bin. Both
             included so the rendered file is portable across Mac SKUs. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- RELAY_TOKEN injected here by install-on-mac.sh and rotated via
             PlistBuddy on demand. Empty string = no auth (NOT recommended
             when exposed through kangatnewyork.com). -->
        <key>RELAY_TOKEN</key>
        <string>__RELAY_TOKEN__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__DATA_DIR__</string>

    <!-- Start at user login; relaunch on crash but not on clean exit.
         ThrottleInterval=5 mirrors systemd's RestartSec=5. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Logs. StandardOutPath is intentionally NOT set — launchd truncates
         it on every (re)start and we want stderr-only routing here. The
         relay_server writes events.jsonl itself via its own file handle. -->
    <key>StandardErrorPath</key>
    <string>__DATA_DIR__/relay-daemon.log</string>

    <!-- Mark as Interactive so the agent gets a normal process priority. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
